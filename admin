                    <td class="p-4 py-3 text-right font-medium text-emerald-600 dark:text-emerald-400">${formatMoney(u.balance)}</td>
                    <td class="p-4 py-3 text-right font-bold text-slate-800 dark:text-white">${formatMoney(u.spent)}</td>
                `;
                table.appendChild(tr);
            });
            lucide.createIcons();
        }

        window.sortAdmUsers = function(field) {
            if (AdminState.userSortBy === field) {
                AdminState.userSortDesc = !AdminState.userSortDesc;
            } else {
                AdminState.userSortBy = field;
                AdminState.userSortDesc = (field === 'spent' || field === 'balance');
            }
            renderAdmUsersTable();
        };

        function buildAndRenderAdminStats() {
            let totalSpentGlobal = 0;
            let totalItemsGlobal = 0;
            AdminState.userStats = {};
            AdminState.itemStats = {};

            if(AdminState.users) {
                AdminState.users.forEach(u => {
                    let userName = u.nome || u.email || `ID: ${u.id.split('-')[0]}`;
                    if (userName.includes('@')) {
                        let namePart = userName.split('@')[0];
                        userName = namePart.split('.').map(part => part.charAt(0).toUpperCase() + part.slice(1)).join(' ');
                    }
                    AdminState.userStats[u.id] = { id: u.id, name: userName, cargo: u.cargo || 'Comercial', balance: parseFloat(u.saldo || 0), spent: 0 };
                });
            }

            if(AdminState.orders) {
                AdminState.orders.forEach(o => {
                    if (o.status !== 'Cancelado') {
                        const vTotal = parseFloat(o.valor_total || 0);
                        totalSpentGlobal += vTotal;

                        if (!AdminState.userStats[o.usuario_id]) {
                            AdminState.userStats[o.usuario_id] = { id: o.usuario_id, name: `ID: ${o.usuario_id.split('-')[0]}`, cargo: 'Comercial', balance: 0, spent: 0 };
                        }
                        AdminState.userStats[o.usuario_id].spent += vTotal;

                        if (o.pedido_itens) {
                            o.pedido_itens.forEach(item => {
                                totalItemsGlobal += item.quantidade;
                            });
                        }
                    }
                });
            }

            els.admTotalSpent.textContent = formatMoney(totalSpentGlobal);
            els.admTotalOrders.textContent = (AdminState.orders ? AdminState.orders.filter(o => o.status !== 'Cancelado').length : 0);
            els.admTotalItems.textContent = totalItemsGlobal + ' un.';

            renderAdmUsersTable();
            renderAdminDailyOrders();
            
            if(!els.adminUserDetailsModal.classList.contains('hidden')) {
                const openUserId = els.adminUserDetailsModal.getAttribute('data-open-user');
                if(openUserId) window.openAdminUserDetails(openUserId, true);
            }
            if(!els.adminSingleOrderModal.classList.contains('hidden')) {
                if(currentEditOrderId && !document.getElementById('editAdmSepDate')) {
                    window.openAdminSingleOrder(currentEditOrderId, true);
                }
            }
        }

