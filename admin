        function renderAdmUsersTable() {
            const table = els.admUsersTable;
            if (!table) return;
            table.innerHTML = '';
            
            let usersArray = Object.values(AdminState.userStats);
            
            if (AdminState.userSearchQuery) {
                const q = AdminState.userSearchQuery.toLowerCase();
                usersArray = usersArray.filter(u => u.name.toLowerCase().includes(q) || u.cargo.toLowerCase().includes(q));
            }

            usersArray.sort((a, b) => {
                let valA = a[AdminState.userSortBy];
                let valB = b[AdminState.userSortBy];
                
                if (typeof valA === 'string') valA = valA.toLowerCase();
                if (typeof valB === 'string') valB = valB.toLowerCase();
                
                if (valA < valB) return AdminState.userSortDesc ? 1 : -1;
                if (valA > valB) return AdminState.userSortDesc ? -1 : 1;
                return 0;
            });

            ['name', 'balance', 'spent'].forEach(field => {
                const iconEl = document.getElementById(`sort-icon-${field}`);
                if (iconEl) {
                    if (AdminState.userSortBy === field) {
                        iconEl.setAttribute('data-lucide', AdminState.userSortDesc ? 'arrow-down' : 'arrow-up');
                        iconEl.classList.add('text-brand-500', 'dark:text-brand-400');
                        iconEl.classList.remove('text-slate-300', 'dark:text-slate-600');
                    } else {
                        iconEl.setAttribute('data-lucide', 'arrow-down-up');
                        iconEl.classList.remove('text-brand-500', 'dark:text-brand-400');
                        iconEl.classList.add('text-slate-300', 'dark:text-slate-600');
                    }
                }
            });

            if (usersArray.length === 0) {
                table.innerHTML = '<tr><td colspan="3" class="text-center p-8 text-slate-400 dark:text-slate-500 text-sm"><i data-lucide="users" class="w-8 h-8 mx-auto mb-2 opacity-30"></i>Nenhum usuário encontrado.</td></tr>';
                lucide.createIcons();
                return;
            }

            usersArray.forEach(u => {
                const tr = document.createElement('tr');
                tr.className = "cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors group";
                tr.onclick = () => window.openAdminUserDetails(u.id);
                tr.innerHTML = `
                    <td class="p-4 py-3 font-semibold text-slate-700 dark:text-slate-200 group-hover:text-brand-600 dark:group-hover:text-brand-400 flex items-center gap-3"><div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center border border-slate-200 dark:border-slate-600 shadow-sm"><i data-lucide="user" class="w-4 h-4 text-slate-500 dark:text-slate-400"></i></div>
