        async function fetchBaseData() {
            const { data: prods } = await supabaseClient.from('produtos').select('*');
            if (prods) {
                State.products = prods.map(p => {
                    let finalIcon = p.icone || 'box';
                    if (overrideImages[p.nome]) finalIcon = overrideImages[p.nome];
                    return {
                        id: p.id, 
                        name: p.nome, 
                        stock: p.estoque, 
                        price: p.preco, 
                        icon: finalIcon,
                        ativo: p.ativo !== false 
                    };
                });
            }
        }

        async function initialAdminLoad() {
            els.adminContent.classList.add('hidden');
            els.adminLoading.classList.remove('hidden');
            els.adminLoadingMsg.textContent = "Sincronizando dados globais...";
            
            const today = new Date();
            const tzOffset = today.getTimezoneOffset() * 60000;
            els.admDailyDate.value = (new Date(today - tzOffset)).toISOString().split('T')[0];

            try {
                await fetchBaseData();
                const { data: users } = await supabaseClient.from('usuarios').select('*');
                const { data: orders } = await supabaseClient.from('pedidos').select('*, pedido_itens(produto_id, quantidade, preco_unitario)').order('data_pedido', { ascending: false });

                AdminState.users = users || [];
                AdminState.orders = orders || [];
                
                if (orders && orders.length > 0) AdminState.lastKnownOrderId = orders[0].id;
                
                buildAndRenderAdminStats();
                lastAdminHash = JSON.stringify({ u: AdminState.users, o: AdminState.orders, p: State.products });

                els.adminLoading.classList.add('hidden');
                els.adminContent.classList.remove('hidden');
                lucide.createIcons();
                
                setInterval(backgroundRefresh, 5000); // Start background sync after initial load
            } catch (err) {
                console.error("Erro painel ADM:", err);
                els.adminLoading.innerHTML = `<span class="text-red-500 font-bold">Falha ao conectar com banco de dados. Verifique a internet ou as permissões.</span>`;
            }
        }

        function showAdmToast(order) {
            const toast = document.getElementById('admToast');
            const text = document.getElementById('admToastText');
            let uName = order.usuario_id;
            if(AdminState.userStats[order.usuario_id]) uName = AdminState.userStats[order.usuario_id].name;
            
            text.textContent = `${uName} solicitou ${formatMoney(order.valor_total)}.`;
            
            toast.classList.remove('hidden');
            void toast.offsetWidth; 
            toast.classList.remove('translate-y-24', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
                setTimeout(() => toast.classList.add('hidden'), 500);
            }, 6000);
        }

        async function backgroundRefresh() {
            try {
                els.admSyncStatus.classList.add('bg-brand-500');
                els.admSyncStatus.classList.remove('bg-emerald-500');
                
                await fetchBaseData(); 

                const { data: users } = await supabaseClient.from('usuarios').select('*');
                const { data: orders } = await supabaseClient.from('pedidos').select('*, pedido_itens(produto_id, quantidade, preco_unitario)').order('data_pedido', { ascending: false });
                
                if (orders && orders.length > 0) {
                    if (AdminState.lastKnownOrderId && AdminState.lastKnownOrderId !== orders[0].id) {
                        const oldLatest = AdminState.orders.find(o => o.id === AdminState.lastKnownOrderId);
                        const newDate = new Date(orders[0].data_pedido);
                        const oldDate = oldLatest ? new Date(oldLatest.data_pedido) : new Date(0);
                        
                        if (newDate > oldDate) {
                            showAdmToast(orders[0]);
                        }
                    }
                    AdminState.lastKnownOrderId = orders[0].id;
                }
                
                AdminState.users = users || [];
                AdminState.orders = orders || [];
                
                const newAdminHash = JSON.stringify({ u: AdminState.users, o: AdminState.orders, p: State.products });
