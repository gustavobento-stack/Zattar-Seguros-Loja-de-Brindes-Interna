                if (!els.adminProductsModal.classList.contains('hidden')) {
                    renderAdminProductsList();
                }

                setTimeout(() => {
                    els.admSyncStatus.classList.add('bg-emerald-500');
                    els.admSyncStatus.classList.remove('bg-brand-500');
                }, 1000);

            } catch (err) {
                console.warn("Erro no sync de background", err);
