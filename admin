            try {
                await supabaseClient.from('pedidos').update({ data_separacao: newDate, observacoes: newNotes }).eq('id', orderId);
                
                const orderIndex = AdminState.orders.findIndex(o => o.id === orderId);
                if(orderIndex !== -1) {
                    AdminState.orders[orderIndex].data_separacao = newDate;
                    AdminState.orders[orderIndex].observacoes = newNotes;
