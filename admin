<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel ADM Comercial</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            200: '#99f6e4',
                            300: '#5eead4',
                            400: '#2dd4bf',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }
        
        .transition-all-ease { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
        input[type="number"] { -moz-appearance: textfield; }
    </style>

    <script>
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</head>
<body class="bg-slate-100 dark:bg-slate-950 text-slate-800 dark:text-slate-100 font-sans h-screen flex flex-col overflow-hidden transition-colors duration-300 relative">

    <div id="adminPasswordModal" class="fixed inset-0 z-[2000] flex items-center justify-center">
        <div class="absolute inset-0 bg-slate-900/90 backdrop-blur-sm rounded-lg"></div>
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-8 max-w-sm w-full mx-4 relative z-10 shadow-2xl transition-all duration-300 border border-slate-100 dark:border-slate-700" id="adminPasswordModalContent">
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-slate-100 dark:bg-slate-700 mb-4 border border-slate-200 dark:border-slate-600">
                <i data-lucide="shield-alert" class="h-8 w-8 text-slate-700 dark:text-slate-300"></i>
            </div>
            <h3 class="text-xl font-bold text-center text-slate-900 dark:text-white mb-2">Acesso Restrito</h3>
            <p class="text-center text-slate-500 dark:text-slate-400 mb-6 text-sm">Insira a credencial de administrador.</p>
            <input type="password" id="adminPasswordInput" class="w-full px-4 py-3 mb-2 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-xl outline-none text-center tracking-widest font-mono text-slate-900 dark:text-white" placeholder="••••••••">
            <div id="adminPasswordError" class="hidden text-red-500 text-xs text-center mb-4 font-bold">Credencial inválida.</div>
            <div class="flex gap-3 mt-4">
                <button id="adminPasswordCancelBtn" class="flex-1 px-4 py-3 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 font-semibold rounded-xl transition-colors">Voltar</button>
                <button id="adminPasswordSubmitBtn" class="flex-1 px-4 py-3 bg-slate-900 dark:bg-brand-600 text-white font-semibold rounded-xl transition-colors">Acessar</button>
            </div>
        </div>
    </div>

    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 px-6 py-4 flex justify-between items-center z-10 transition-colors duration-300 shadow-sm">
        <div class="flex items-center gap-3">
            <img src="https://i.imgur.com/DeN7M4G.png" alt="Zattar" class="h-8 sm:h-10 w-auto object-contain block dark:hidden">
            <img src="https://i.imgur.com/2HfPsZz.png" alt="Zattar" class="h-8 sm:h-10 w-auto object-contain hidden dark:block">
            <div class="flex items-center gap-2 ml-2 pl-4 border-l border-slate-200 dark:border-slate-700">
                <span class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-widest hidden sm:block">Painel ADM</span>
                <span id="admSyncStatus" class="inline-block w-2 h-2 rounded-full bg-emerald-500 ml-1 animate-pulse" title="Sincronização em tempo real ativa"></span>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button id="themeToggleBtn" type="button" class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-600 text-slate-500 dark:text-slate-300 transition-colors ml-1 shadow-sm">
                <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
                <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
            </button>
            <button id="openAdminProductsBtn" class="flex items-center gap-2 px-4 py-2.5 h-10 bg-brand-600 hover:bg-brand-500 border border-transparent text-white rounded-lg text-sm font-medium transition-colors shadow-sm">
                <i data-lucide="package" class="w-4 h-4"></i> <span class="hidden sm:inline">Catálogo</span>
            </button>
            <button id="closeAdminBtn" class="flex items-center gap-2 px-4 py-2.5 h-10 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 rounded-lg text-sm font-medium transition-colors shadow-sm">
                <i data-lucide="log-out" class="w-4 h-4"></i> <span class="hidden sm:inline">Sair do ADM</span>
            </button>
        </div>
    </header>

    <div class="flex-1 overflow-y-auto p-6 lg:p-10 relative">
        <div id="adminLoading" class="flex flex-col justify-center items-center h-full min-h-[300px] gap-3">
            <i data-lucide="loader-2" class="w-8 h-8 text-brand-500 animate-spin"></i>
            <span class="text-slate-500 text-sm font-medium" id="adminLoadingMsg">Aguardando login administrativo...</span>
        </div>

        <div id="adminContent" class="hidden max-w-7xl mx-auto space-y-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow flex items-center gap-5 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-red-500/10 rounded-bl-full -mr-10 -mt-10 pointer-events-none transition-transform group-hover:scale-110"></div>
                    <div class="w-14 h-14 bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 rounded-2xl flex items-center justify-center shrink-0 border border-red-100 dark:border-red-800/50">
                        <i data-lucide="trending-down" class="w-7 h-7"></i>
                    </div>
                    <div>
                        <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Custo Total Gerado</p>
                        <h3 class="text-3xl font-black text-slate-800 dark:text-white" id="admTotalSpent">R$ 0,00</h3>
                    </div>
                </div>
                <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow flex items-center gap-5 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-bl-full -mr-10 -mt-10 pointer-events-none transition-transform group-hover:scale-110"></div>
                    <div class="w-14 h-14 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-2xl flex items-center justify-center shrink-0 border border-blue-100 dark:border-blue-800/50">
                        <i data-lucide="layers" class="w-7 h-7"></i>
                    </div>
                    <div>
                        <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Total de Pedidos</p>
                        <h3 class="text-3xl font-black text-slate-800 dark:text-white" id="admTotalOrders">0</h3>
                    </div>
                </div>
                <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow flex items-center gap-5 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-bl-full -mr-10 -mt-10 pointer-events-none transition-transform group-hover:scale-110"></div>
                    <div class="w-14 h-14 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 rounded-2xl flex items-center justify-center shrink-0 border border-emerald-100 dark:border-emerald-800/50">
                        <i data-lucide="package-check" class="w-7 h-7"></i>
                    </div>
                    <div>
                        <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Itens Movimentados</p>
                        <h3 class="text-3xl font-black text-slate-800 dark:text-white" id="admTotalItems">0 un.</h3>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden flex flex-col h-[550px]">
                    <div class="p-5 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-slate-800 dark:text-white flex items-center gap-2">
                                <i data-lucide="users" class="w-5 h-5 text-brand-600 dark:text-brand-400"></i> Desempenho por Usuário
                            </h3>
                            <p class="text-xs text-slate-500 mt-1">Busque, ordene e gerencie o time.</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="relative w-full sm:w-48">
                                <i data-lucide="search" class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 w-3.5 h-3.5"></i>
                                <input type="text" id="admUserSearchInput" placeholder="Buscar usuário..." class="w-full pl-8 pr-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-lg text-xs outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 text-slate-900 dark:text-white transition-colors shadow-sm">
                            </div>
                            <button id="admExportUsersBtn" title="Exportar CSV" class="p-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition-colors shadow-sm">
                                <i data-lucide="download" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                    <div class="flex-1 overflow-y-auto p-0 no-scrollbar relative">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-white dark:bg-slate-800 sticky top-0 z-10 shadow-sm">
                                <tr class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-200 dark:border-slate-700 select-none">
                                    <th class="p-4 py-3 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors group" onclick="sortAdmUsers('name')">
                                        <div class="flex items-center gap-1">Usuário <i data-lucide="arrow-down-up" id="sort-icon-name" class="w-3 h-3 text-slate-300 dark:text-slate-600 group-hover:text-slate-400"></i></div>
                                    </th>
                                    <th class="p-4 py-3 text-right cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors group" onclick="sortAdmUsers('balance')">
                                        <div class="flex items-center justify-end gap-1">Budget <i data-lucide="arrow-down-up" id="sort-icon-balance" class="w-3 h-3 text-slate-300 dark:text-slate-600 group-hover:text-slate-400"></i></div>
                                    </th>
                                    <th class="p-4 py-3 text-right cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors group" onclick="sortAdmUsers('spent')">
                                        <div class="flex items-center justify-end gap-1">Gasto <i data-lucide="arrow-down-up" id="sort-icon-spent" class="w-3 h-3 text-slate-300 dark:text-slate-600 group-hover:text-slate-400"></i></div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="admUsersTable" class="divide-y divide-slate-100 dark:divide-slate-700/50 text-sm"></tbody>
                        </table>
                    </div>
                </div>

                <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden flex flex-col h-[550px]">
                    <div class="p-5 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 flex justify-between items-center gap-2">
                        <div>
                            <h3 class="font-bold text-slate-800 dark:text-white flex items-center gap-2">
                                <i data-lucide="calendar-clock" class="w-5 h-5 text-brand-600 dark:text-brand-400"></i> Pedidos
                            </h3>
                            <p class="text-xs text-slate-500 mt-1">Acompanhamento logístico diário</p>
                        </div>
                        <input type="date" id="admDailyDate" class="px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-lg text-xs font-semibold outline-none text-slate-700 dark:text-slate-200 [color-scheme:light] dark:[color-scheme:dark] w-[140px] shadow-sm">
                    </div>
                    <div class="flex-1 overflow-y-auto p-0 no-scrollbar relative">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-white dark:bg-slate-800 sticky top-0 z-10 shadow-sm">
                                <tr class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-200 dark:border-slate-700">
                                    <th class="p-4 py-3">ID / Hora</th>
                                    <th class="p-4 py-3">Usuário</th>
                                    <th class="p-4 py-3 text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody id="admDailyOrdersTable" class="divide-y divide-slate-100 dark:divide-slate-700/50 text-sm"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="actionConfirmModal" class="fixed inset-0 z-[1600] flex items-center justify-center hidden">
        <div class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm rounded-lg" id="actionConfirmModalBg"></div>
        <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 max-w-sm w-full mx-4 relative z-10 shadow-2xl transform scale-95 opacity-0 transition-all duration-300 border border-slate-100 dark:border-slate-700" id="actionConfirmModalContent">
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full mb-4 border" id="actionConfirmIconContainer">
                <i data-lucide="alert-triangle" class="h-8 w-8" id="actionConfirmIcon"></i>
            </div>
            <h3 class="text-xl font-bold text-center text-slate-900 dark:text-white mb-2" id="actionConfirmTitle">Atenção</h3>
            <p class="text-center text-slate-500 dark:text-slate-400 mb-6 text-sm" id="actionConfirmText">Tem certeza?</p>
            <div class="flex gap-3">
                <button id="actionCancelBtn" class="flex-1 px-4 py-3 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-semibold rounded-xl transition-colors">Voltar</button>
                <button id="actionConfirmBtn" class="flex-1 px-4 py-3 text-white font-semibold rounded-xl transition-colors shadow-sm">Confirmar</button>
            </div>
        </div>
    </div>

    <div id="adminEditUserModal" class="fixed inset-0 z-[1500] flex items-center justify-center hidden">
        <div class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm rounded-lg" id="adminEditUserModalBg"></div>
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 max-w-sm w-full mx-4 relative z-10 shadow-2xl transform scale-95 opacity-0 transition-all duration-300 border border-slate-100 dark:border-slate-700" id="adminEditUserModalContent">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2"><i data-lucide="user-cog" class="w-5 h-5 text-brand-600 dark:text-brand-400"></i> Editar Usuário</h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Nome Completo</label>
                    <input type="text" id="editUserName" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm dark:text-white focus:border-brand-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Cargo / Setor</label>
                    <input type="text" id="editUserRole" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm dark:text-white focus:border-brand-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Saldo (R$)</label>
                    <input type="number" id="editUserBalance" step="0.01" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm dark:text-white focus:border-brand-500 outline-none">
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button id="cancelEditUserBtn" class="flex-1 px-4 py-2.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-sm font-semibold transition-colors">Cancelar</button>
                <button id="saveEditUserBtn" class="flex-1 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm flex items-center justify-center gap-2">Salvar</button>
            </div>
        </div>
    </div>

    <div id="adminEditProductModal" class="fixed inset-0 z-[1500] flex items-center justify-center hidden">
        <div class="absolute inset-0 bg-slate-900/80 backdrop-blur-sm rounded-lg" id="adminEditProductModalBg"></div>
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 max-w-md w-full mx-4 relative z-10 shadow-2xl transform scale-95 opacity-0 transition-all duration-300 border border-slate-100 dark:border-slate-700" id="adminEditProductModalContent">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2"><i data-lucide="edit-3" class="w-5 h-5 text-brand-600 dark:text-brand-400"></i> Editar Produto</h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Nome do Produto</label>
                    <input type="text" id="editProdName" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm dark:text-white focus:border-brand-500 outline-none">
                </div>
                <div class="flex gap-4">
                    <div class="flex-1">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Estoque Físico</label>
                        <input type="number" id="editProdStock" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm dark:text-white focus:border-brand-500 outline-none">
                    </div>
                    <div class="flex-1">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Preço Unit. (R$)</label>
                        <input type="number" step="0.01" id="editProdPrice" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm dark:text-white focus:border-brand-500 outline-none">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Ícone ou Link da Imagem</label>
                    <input type="text" id="editProdIcon" placeholder="Ex: box ou https://i.imgur.com/img.png" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm dark:text-white focus:border-brand-500 outline-none">
                    <p class="text-[10px] text-slate-400 mt-1">Cole um link de internet (HTTP) para mostrar imagem real.</p>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Status no Catálogo</label>
                    <select id="editProdStatus" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm dark:text-white focus:border-brand-500 outline-none">
                        <option value="ativo">🟢 Ativo (Visível para o time)</option>
                        <option value="pausado">🔴 Pausado (Oculto / Bloqueado)</option>
                    </select>
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button id="cancelEditProdBtn" class="flex-1 px-4 py-2.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-sm font-semibold transition-colors">Cancelar</button>
                <button id="saveEditProdBtn" class="flex-1 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm flex items-center justify-center gap-2">Salvar Alterações</button>
            </div>
        </div>
    </div>

    <div id="adminSingleOrderModal" class="fixed inset-0 z-[1400] flex items-center justify-center hidden">
        <div class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm rounded-lg" id="adminSingleOrderModalBg"></div>
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 max-w-2xl w-full mx-4 relative z-10 shadow-2xl flex flex-col h-auto max-h-[90vh] transform scale-95 opacity-0 transition-all duration-300 border border-slate-100 dark:border-slate-700" id="adminSingleOrderModalContent">
            <div class="flex justify-between items-center mb-5 border-b border-slate-100 dark:border-slate-700 pb-4">
                <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <i data-lucide="file-text" class="w-5 h-5 text-brand-600 dark:text-brand-400"></i> Detalhes do Pedido
                </h3>
