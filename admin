                    <td class="p-4 py-3 text-right font-semibold text-brand-600 dark:text-brand-400">${formatMoney(p.price)}</td>
                    <td class="p-4 py-3 text-center">${statusBadge}</td>
                    <td class="p-4 py-3 text-right">
                        <button onclick="openAdminEditProduct('${p.id}')" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-lg text-xs font-semibold transition-colors border border-transparent shadow-sm inline-flex items-center gap-1.5"><i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Editar</button>
                    </td>
                `;
                els.adminProductsList.appendChild(tr);
            });
            lucide.createIcons();
        }

        els.openAdminProductsBtn.addEventListener('click', () => {
            renderAdminProductsList();
            els.adminProductsModal.classList.remove('hidden');
            setTimeout(() => {
                els.adminProductsModalContent.classList.remove('scale-95', 'opacity-0');
                els.adminProductsModalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
        });

        els.closeAdminProductsBtn.addEventListener('click', () => {
            els.adminProductsModalContent.classList.remove('scale-100', 'opacity-100');
            els.adminProductsModalContent.classList.add('scale-95', 'opacity-0');
            setTimeout(() => els.adminProductsModal.classList.add('hidden'), 300);
        });

        window.openAdminEditProduct = function(productId) {
            const product = State.products.find(p => p.id === productId);
            if (!product) return;
            
            editingProductId = productId;
            
            els.editProdName.value = product.name;
            els.editProdStock.value = product.stock;
            els.editProdPrice.value = product.price ? product.price.toFixed(2) : 0;
            els.editProdIcon.value = product.icon;
            els.editProdStatus.value = product.ativo ? "ativo" : "pausado";
            
            els.adminEditProductModal.classList.remove('hidden');
            setTimeout(() => {
                els.adminEditProductModalContent.classList.remove('scale-95', 'opacity-0');
                els.adminEditProductModalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
        };

        els.cancelEditProdBtn.addEventListener('click', () => {
            els.adminEditProductModalContent.classList.remove('scale-100', 'opacity-100');
            els.adminEditProductModalContent.classList.add('scale-95', 'opacity-0');
            setTimeout(() => els.adminEditProductModal.classList.add('hidden'), 300);
        });

        els.saveEditProdBtn.addEventListener('click', async () => {
            if (!editingProductId) return;
            
            const newName = els.editProdName.value;
            const newStock = parseInt(els.editProdStock.value) || 0;
            const newPrice = parseFloat(els.editProdPrice.value) || 0;
            const newIcon = els.editProdIcon.value || "box";
            const newActive = els.editProdStatus.value === "ativo";
            
            els.saveEditProdBtn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i>';
            lucide.createIcons();
            
            try {
                await supabaseClient.from('produtos').update({ 
                    nome: newName, 
                    estoque: newStock, 
                    preco: newPrice, 
                    icone: newIcon,
                    ativo: newActive 
                }).eq('id', editingProductId);
                
                const productIndex = State.products.findIndex(p => p.id === editingProductId);
                if (productIndex !== -1) {
                    State.products[productIndex].name = newName;
                    State.products[productIndex].stock = newStock;
                    State.products[productIndex].price = newPrice;
                    State.products[productIndex].icon = newIcon;
                    State.products[productIndex].ativo = newActive;
                }
                
                els.cancelEditProdBtn.click();
                renderAdminProductsList(); 
                backgroundRefresh(); 

            } catch (err) {
                console.error("Erro ao atualizar produto:", err);
            } finally {
                els.saveEditProdBtn.innerHTML = 'Salvar Alterações';
            }
        });

        els.openEditUserBtn?.addEventListener('click', () => {
            if (!editingUserId) return;
            const uStats = AdminState.userStats[editingUserId];
            
            els.editUserName.value = uStats.name;
            els.editUserRole.value = uStats.cargo;
            els.editUserBalance.value = uStats.balance.toFixed(2);
            
            els.adminEditUserModal.classList.remove('hidden');
            setTimeout(() => {
                els.adminEditUserModalContent.classList.remove('scale-95', 'opacity-0');
                els.adminEditUserModalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
        });

        els.cancelEditUserBtn?.addEventListener('click', () => {
            els.adminEditUserModalContent.classList.remove('scale-100', 'opacity-100');
            els.adminEditUserModalContent.classList.add('scale-95', 'opacity-0');
            setTimeout(() => els.adminEditUserModal.classList.add('hidden'), 300);
        });

        els.saveEditUserBtn?.addEventListener('click', async () => {
            if (!editingUserId) return;
            
            const newName = els.editUserName.value;
            const newRole = els.editUserRole.value;
            const newBalance = parseFloat(els.editUserBalance.value);
            
            els.saveEditUserBtn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i>';
            lucide.createIcons();
            
            try {
                await supabaseClient.from('usuarios').update({ 
                    nome: newName, 
                    cargo: newRole, 
                    saldo: newBalance 
                }).eq('id', editingUserId);
                
                if (AdminState.userStats[editingUserId]) {
                    AdminState.userStats[editingUserId].name = newName;
                    AdminState.userStats[editingUserId].cargo = newRole;
                    AdminState.userStats[editingUserId].balance = newBalance;
                }
                
                els.cancelEditUserBtn.click();
                window.openAdminUserDetails(editingUserId, true); 
                backgroundRefresh(); 

            } catch (err) {
                console.error("Erro ao atualizar usuário:", err);
            } finally {
                els.saveEditUserBtn.innerHTML = 'Salvar';
            }
        });

        els.closeAdminUserModalBtn.addEventListener('click', () => {
            els.adminUserDetailsModalContent.classList.remove('scale-100', 'opacity-100');
            els.adminUserDetailsModalContent.classList.add('scale-95', 'opacity-0');
            setTimeout(() => { els.adminUserDetailsModal.classList.add('hidden'); els.adminUserDetailsModal.removeAttribute('data-open-user'); }, 300);
        });

        window.adminCompleteOrder = function(orderId, userId) {
            showActionConfirm('Concluir Separação', 'Deseja marcar este pedido como Concluído? O usuário comercial verá o status atualizado e a Planilha também.', 'warning', 'Sim, Concluir', async () => {
                await supabaseClient.from('pedidos').update({ status: 'Separação Concluída' }).eq('id', orderId);
                
                try {
                    const webhookUrl = 'https://script.google.com/macros/s/AKfycbwjbabC0IAu0zcdibuaNPVH33tljr4Lhmequ-fiCwbb5dI8YCAQEa_8FcxXe1Norpbrgw/exec';
                    const webhookData = { action: "updateStatus", orderId: orderId, status: 'Separação Concluída' };
                    await fetch(webhookUrl, { 
                        method: 'POST', 
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'text/plain' },
                        body: JSON.stringify(webhookData) 
                    }).catch(e => console.log('Webhook update status concluído'));
                } catch (webhookErr) { }

                backgroundRefresh(); 
                if(currentEditOrderId === orderId) els.closeSingleOrderModalBtn.click();
            });
        };

        window.adminDeleteOrder = function(orderId, userId) {
            showActionConfirm('Excluir Registro Totalmente', 'Deseja apagar este registro da base de dados? O valor em reais será devolvido ao usuário e os brindes retornarão ao estoque.', 'danger', 'Sim, Excluir', async () => {
                const order = AdminState.orders.find(o => o.id === orderId);
                if (!order) return;
                
                let uStats = AdminState.userStats[userId];
                if(uStats) {
                    let newBalance = uStats.balance + parseFloat(order.valor_total || 0);
                    await supabaseClient.from('usuarios').update({ saldo: newBalance }).eq('id', userId);
                }
                
                if(order.pedido_itens) {
                    for(let item of order.pedido_itens) {
                        const product = State.products.find(p => p.id === item.produto_id);
                        if (product) {
                            await supabaseClient.from('produtos').update({ estoque: product.stock + item.quantidade }).eq('id', item.produto_id);
                        }
                    }
                }
                
                await supabaseClient.from('pedidos').delete().eq('id', orderId);
                backgroundRefresh();
                
                if(currentEditOrderId === orderId) els.closeSingleOrderModalBtn.click();
            });
        };

        window.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            setTimeout(() => {
                els.adminPasswordInput.focus();
            }, 100);
        });

    </script>
</body>
</html>
